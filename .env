# docker compose 宿主机端口固化（本机开发直连用；容器间互访走内网 DNS 不受影响）
# 固化原因：Docker Desktop 端口占用自动避让会在容器重建时改端口，导致本机配置漂移
# 注意：SANDBOX_HOST_PORT 只在 docker-compose.dev.yml（本地开发覆盖层）生效；
# 基础形态的 sandbox 只挂 internal 网络、不发布宿主机端口（P0-1 网络硬隔离）。
MYSQL_HOST_PORT=3317
REDIS_HOST_PORT=16379
SANDBOX_HOST_PORT=18190
SERVICE_HOST_PORT=8080
SEARXNG_HOST_PORT=8888
